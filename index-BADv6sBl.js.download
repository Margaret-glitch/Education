        @keyframes deadRiseOut {
          0% { transform: translateY(0) scale(1); opacity: 1; }
          45% { transform: translateY(-130%) scale(0.9); opacity: 0; }
          100% { transform: translateY(-130%) scale(0.9); opacity: 0; }
        }
        @keyframes deadRiseIn {
          0% { transform: translateY(130%) scale(0.9); opacity: 0; }
          50% { transform: translateY(130%) scale(0.9); opacity: 0; }
          85% { transform: translateY(-6%) scale(1.05); opacity: 1; }
          100% { transform: translateY(0) scale(1); opacity: 1; }
        }
        @keyframes confettiPop {
          0% {
            transform: translate(0, 0) scale(0) rotate(0deg);
            opacity: 1;
          }
          60% {
            opacity: 1;
          }
          100% {
            transform: translate(var(--tx), var(--ty)) scale(1) rotate(var(--rot));
            opacity: 0;
          }
        }
        .phone-rise-out {
          animation: deadRiseOut 0.85s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }
        .phone-rise-in {
