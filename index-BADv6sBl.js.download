        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #333;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #444;
        }
        .code-highlight {
            animation: highlight-flash 1.5s ease-out forwards;
            border-radius: 4px;
        }
        @keyframes highlight-flash {
            0% { background-color: rgba(168, 85, 247, 0.4); }
            100% { background-color: transparent; }
        }
        #neon-glow-overlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 50;
            box-shadow: 
                inset 0 0 80px -20px rgba(56, 189, 248, 0.15),
                inset 0 0 40px -10px rgba(168, 85, 247, 0.15);
            border: 1px solid rgba(168, 85, 247, 0.2);
        }
        .inspector-active #neon-glow-overlay {
            opacity: 1;
        }
        .tab-btn {
            position: relative;
            color: #6b7280;
            transition: color 0.2s;
        }
        .tab-btn:hover { color: #d1d5db; }
        .tab-btn.active { color: #fff; }
        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            right: 0;
            height: 2px;
            background-color: #3b82f6;
